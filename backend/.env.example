# ═══════════════════════════════════════════════
#  ResearchAI Backend — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ─── Application ───────────────────────────────
APP_NAME=ResearchAI
APP_ENV=development           # development | production
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://researchai:researchai_secret@postgres:5432/researchai_db
SYNC_DATABASE_URL=postgresql://researchai:researchai_secret@postgres:5432/researchai_db
POSTGRES_USER=researchai
POSTGRES_PASSWORD=researchai_secret
POSTGRES_DB=researchai_db

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://:redis_secret@redis:6379/0
REDIS_PASSWORD=redis_secret

# ─── JWT Auth ──────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-very-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── LLM Provider ─────────────────────────────
LLM_PROVIDER=gemini                      # gemini | openai | anthropic
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key       # optional fallback
ANTHROPIC_API_KEY=your-anthropic-api-key # optional fallback
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ─── Search APIs ───────────────────────────────
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
SERPAPI_KEY=your-serpapi-key             # alternative to Brave
TAVILY_API_KEY=your-tavily-api-key       # alternative to Brave

# ─── Academic APIs ─────────────────────────────
NCBI_API_KEY=your-ncbi-api-key           # PubMed (free at https://www.ncbi.nlm.nih.gov/account/)
SEMANTIC_SCHOLAR_API_KEY=               # optional, improves rate limits
OPENALEX_EMAIL=your-email@domain.com    # polite pool access
CROSSREF_PLUS_TOKEN=                    # optional Crossref Plus token

# ─── Books API ─────────────────────────────────
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ─── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@researchai.com

# ─── File Storage ──────────────────────────────
REPORTS_DIR=/app/reports
MAX_REPORT_SIZE_MB=50

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ─── Agent Configuration ───────────────────────
AGENT_TIMEOUT_SECONDS=30
MAX_RESULTS_PER_AGENT=10
MAX_PARALLEL_AGENTS=8

# ─── Celery ────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@redis:6379/2

# ─── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | text
